# ==============================================================================
# Backend Server Configuration (apps/api)
# ==============================================================================
# Copy this file to apps/api/.env:
#   cp apps/api/.env.example apps/api/.env
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port
PORT=4000

# ------------------------------------------------------------------------------
# Database Configuration (Pluggable Repository Pattern)
# ------------------------------------------------------------------------------
# DB_DRIVER options:
#   - 'memory'   : In-memory store (zero external dependencies, perfect for testing/offline dev)
#   - 'postgres' : PostgreSQL via Drizzle ORM (requires DATABASE_URL)
DB_DRIVER=memory

# PostgreSQL Connection String (Required only if DB_DRIVER=postgres)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db

# ------------------------------------------------------------------------------
# Security & Authentication (JWT / Secrets)
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens (min 32 characters in production)
JWT_SECRET=super-secret-development-key-change-me-in-production-min-32-chars

# ------------------------------------------------------------------------------
# CORS & Allowed Origins
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000





REDIS_ENABLED=false              # Set to true for local/production Redis, false for offline in-memory fallback
REDIS_URL=redis://localhost:6379 # Upstash, Redis Cloud, or local Docker
CACHE_TTL_SECONDS=300