{
  "name": "agentic-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "setup": "node scripts/bootstrap.mjs && npm install --legacy-peer-deps && npm run check",
    "bootstrap": "npm run setup"
  },
  "devDependencies": {
    "oxfmt": "^0.1.0",
    "oxlint": "^0.15.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}