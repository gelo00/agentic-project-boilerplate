{
  "name": "agentic-project-boilerplate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:modules": "node scripts/check-nested-modules.mjs",
    "check": "npm run check:modules && npm run check:types && npm run check:lint",
    "ai:compact": "node scripts/compact-sessions.mjs",
    "pre-commit": "npm run check && npm run ai:compact",
    "clean:cache": "node scripts/clean-cache.mjs --all",
    "clean:cache:web": "node scripts/clean-cache.mjs --web",
    "clean:cache:api": "node scripts/clean-cache.mjs --api",
    "clean": "node scripts/clean.mjs",
    "reset": "npm run clean && npm run setup",
    "setup": "node scripts/bootstrap.mjs && npm install --legacy-peer-deps && npm run check",
    "bootstrap": "npm run setup",
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev --workspace=@workspace/web\" \"npm run dev --workspace=@workspace/api\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "concurrently": "^9.1.2",
    "oxfmt": "^0.1.0",
    "oxlint": "^0.15.11",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
