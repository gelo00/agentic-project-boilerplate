{
  "name": "agentic-project-boilerplate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/ensure-root-install.mjs",
    "clean:modules": "node scripts/check-duplicate-packages.mjs --fix",
    "check:modules": "node scripts/check-duplicate-packages.mjs",
    "check": "npm run check:modules && npm run check:types && npm run check:lint",
    "setup": "node scripts/bootstrap.mjs && node scripts/check-duplicate-packages.mjs --fix && npm install --install-strategy=hoisted --legacy-peer-deps && node scripts/check-duplicate-packages.mjs --fix && npm run check",
    "ai:compact": "node scripts/compact-sessions.mjs",
    "pre-commit": "npm run check && npm run ai:compact",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "clean:cache": "node scripts/clean-cache.mjs --all",
    "clean:cache:web": "node scripts/clean-cache.mjs --web",
    "clean:cache:api": "node scripts/clean-cache.mjs --api",
    "clean": "node scripts/clean.mjs",
    "reset": "npm run clean && npm run setup",
    "bootstrap": "npm run setup",
    "dev": "concurrently -k -p \"[{name}]\" -n \"web,api\" -c \"cyan.bold,green.bold\" \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@workspace/web",
    "dev:api": "npm run dev --workspace=@workspace/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "test": "vitest run",
    "prepare": "simple-git-hooks",
    "check:lint": "oxlint apps/ packages/ && oxfmt --check apps/ packages/",
    "check:types": "tsc -b packages/contracts packages/ai-hub apps/api apps/web"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check:modules && npx lint-staged && npm run check:types"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "oxlint --fix"
    ],
    "apps/api/**/*.{ts,js}": [
      "oxlint --fix"
    ],
    "packages/**/*.{ts,js}": [
      "oxlint --fix"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/ioredis": "4.28.10",
    "@types/node": "26.6.6",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.4",
    "lint-staged": "17.6.0",
    "oxfmt": "0.1.0",
    "oxlint": "0.15.15",
    "postcss": "^8.5.1",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^4.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@workspace/ai-hub": "*",
    "@workspace/contracts": "*",
    "antd": "^5.23.4",
    "cors": "2.8.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "ioredis": "6.0.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  }
}
